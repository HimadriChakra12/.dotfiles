set $mod Mod1
set $super Mod4
# set $term alacritty
set $term st

set $i3 bash $HOME/.dotfiles/i3/scripts

#FONT
font pango:JetbrainsMono Nerd Font 16

set $volup XF86AudioRaiseVolume
set $vollow XF86AudioLowerVolume
set $brightup XF86MonBrightnessUp
set $brightdown XF86MonBrightnessDown
set $mute XF86AudioMute
set $micmute XF86AudioMicMute

# KEYBIND BRIGHTNESS AND VOLUME
set $i3status killall -SIGUSR1 i3status
bindsym Shift+$volup exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ 140% && $i3status
bindsym $vollow exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $i3status
bindsym $volup exec --no-startup-id $i3/volume_raise && $i3status
bindsym $brightup exec --no-startup-id brightnessctl set +10% && $i3/scripts/brightness
bindsym $brightdown exec --no-startup-id brightnessctl set 10%- && $i3/scripts/brightness
bindsym $mute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $i3status
bindsym $micmute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $i3status

set $noid --no-startup-id
#STARTUP
exec xsetroot -cursor_name left_ptr &         
exec $noid /usr/bin/env GTK_THEME=Adwaita:dark
exec $noid greenclip daemon
exec $noid $i3/scripts/nightlight
exec $noid ibus start
exec $noid libinput-gestures
exec $noid xdman-beta
exec $noid xclip
exec $noid doid

exec $noid /usr/local/bin/volume-monitor

#WALLPAPER
# exec_always --no-startup-id bash ~/.config/i3/Wallpaper/randomize.sh

exec_always $noid rsxiv -B /home/himadri/.dotfiles/Wallpaper/Wallpaper
bindsym $super+l exec i3lock \
  --image "$HOME/.dotfiles/Wallpaper/Lock/pinkedbutAfraig.jpeg" \
  --fill

## CUSTOM SCRIPTS
bindsym $super+Shift+s exec shot
bindsym $super+Shift+c exec px
bindsym $mod+Return ; exec $term
bindsym $super+Tab exec rofi -show window
bindsym $super+v exec rofi -modi "clipboard:greenclip print" -show clipboard
bindsym $super+e workspace $ws4; , exec rdfm
bindsym $super+w workspace $ws4; , exec chromium-bin
bindsym $mod+space exec $noid rofi -show drun

bindsym $mod+Shift+p exec $i3/rofi/powerrofi
bindsym $mod+r exec $i3/nightlight
bindsym $mod+Shift+m exec $i3/rofi/library
bindsym $super+Shift+period exec $i3/rofi/stickerpicker
bindsym $super+comma exec $i3/rofi/wallpaper
bindsym $super+g exec $i3/rofi/gamelauncher
bindsym $mod+shift+b exec $i3/rofi/bluetooth
bindsym $super+m exec $i3/rofi/musicpicker
bindsym $super+p exec $i3/rofi/powermenu
bindsym $super+period exec $i3/rofi/emojipicker
bindsym $super+r exec $i3/rofi/screenrecorder
bindsym $mod+shift+t exec $i3/rofi/timer
bindsym $super+s exec $i3/empty_workspace
bindsym $super+Shift+w exec $i3/recog.sh
bindsym $super+u exec $i3/rofi/urlman
bindsym $super+slash exec $i3/rofi/cmd
bindsym $super+y exec sh $i3/rofi/yt

bindsym $mod+p exec $i3/browser http://localhost:3000
bindsym $super+i exec $i3/browser https://instagram.com
bindsym $super+f exec $i3/browser https://messenger.com
bindsym $super+Shift+m exec $i3/browser https://open.spotify.com

## RESIZING
set $weztop wezterm start --class btop
set $altop alacritty --title btop --class btop -e
set $stop st -t dtop -c dtop

set $float floating enable, move position center
set $resize resize set 1200 800

bindsym Ctrl+Shift+Escape exec $stop dtop

for_window [class="qimgv"] $float, $resize
for_window [class="dtop"] $float
for_window [class="xdm-app"] $float
for_window [class="Xdm-app"] $float

## WINDOW NAVIGATION 
floating_modifier $mod
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# MOVEMENT WINDOW
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ADDITIONAL LAYOUT
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+s layout tabbed
bindsym $mod+w layout stack
bindsym $mod+s layout toggle split
#bindsym shift+space focus mode_toggle
bindsym $mod+a focus parent
#bindsym ctrl+space exec --no-startup-id dmenu_run
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart

set $n workspace number

## SWITCH TO WORKSPACE
bindsym $mod+1 $n $ws1
bindsym $mod+2 $n $ws2
bindsym $mod+3 $n $ws3
bindsym $mod+4 $n $ws4
bindsym $mod+5 $n $ws5
bindsym $mod+6 $n $ws6
bindsym $mod+7 $n $ws7
bindsym $mod+8 $n $ws8
bindsym $mod+9 $n $ws9
bindsym $mod+0 $n $ws10

set $move move container to workspace number

## MOVE FOCUSED 
bindsym $mod+Shift+1 $move $ws1  , $n $ws1
bindsym $mod+Shift+2 $move $ws2  , $n $ws2
bindsym $mod+Shift+3 $move $ws3  , $n $ws3
bindsym $mod+Shift+4 $move $ws4  , $n $ws4
bindsym $mod+Shift+5 $move $ws5  , $n $ws5
bindsym $mod+Shift+6 $move $ws6  , $n $ws6
bindsym $mod+Shift+7 $move $ws7  , $n $ws7
bindsym $mod+Shift+8 $move $ws8  , $n $ws8
bindsym $mod+Shift+9 $move $ws9  , $n $ws9
bindsym $mod+Shift+0 $move $ws10 , $n $ws10

## BORDER RULE
set $blue_focused #31748f     
set $grey_unfocused #6e6a86     

client.focused           $blue_focused  $blue_focused  #e0def4  $blue_focused  $blue_focused
client.focused_inactive  $grey_unfocused  $grey_unfocused  #908caa  $grey_unfocused  $grey_unfocused
client.unfocused         $grey_unfocused  $grey_unfocused  #6e6a86  $grey_unfocused  $grey_unfocused
client.urgent            $blue_focused  $blue_focused  #e0def4  $blue_focused  $blue_focused
client.placeholder       $grey_unfocused  $grey_unfocused  #e0def4  $grey_unfocused  $grey_unfocused
client.background        $grey_unfocused


bar {
    font pango: JetBrainsMono Nerd Font 8
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    position bottom
    tray_padding 4
    strip_workspace_numbers yes
    strip_workspace_name no
    tray_output primary
    i3bar_command i3bar --bar_id bar-0

    colors {
        background #282828      # gruvbox dark bg
        statusline #ebdbb2      # gruvbox fg
        separator  #504945      # gruvbox gray

        focused_workspace  #d5c4a1 #d5c4a1 #282828  # wheat bg, dark text
        inactive_workspace #282828 #282828 #fbf1c7  # subtle inactive
    }
}
## WINDOW RULE
for_window [class=".*"] border pixel 0

## APPLICATION KEYBIND
bindsym $mod+b workspace $ws2; , exec firefox
bindsym $mod+bracketleft workspace prev
bindsym $mod+Tab focus next
bindsym $mod+bracketright workspace next

# Toggle floating for the focused window
bindsym $mod+t floating toggle

#Endeavour Flavours
gaps inner 6
gaps outer 3

set $ws1    "1:one"
set $ws2    "2:two"
set $ws3    "3:three"
set $ws4    "4:four"
set $ws5    "5:five"
set $ws6    "6:sis"
set $ws7    "7:seven"
set $ws8    "8:eight"
set $ws9    "9:nine"
set $ws10   "10:ten"
